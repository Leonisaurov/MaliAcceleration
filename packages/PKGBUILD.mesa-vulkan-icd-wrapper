# PKGBUILD for mesa-vulkan-icd-wrapper
#
# This package provides the Vulkan ICD JSON configuration that allows
# ANGLE to find Mali's Vulkan driver via Termux's vulkan-loader-generic.
#
# Two methods are available:
#   1. From source (recommended): Creates the ICD config by detecting Mali's
#      vulkan driver on the device (works on most stock Android systems)
#   2. Binary: Uses the pre-built .deb from ar37-rs (fallback)
#
# Method 1 is used by default. The ICD wrapper simply registers Mali's
# system Vulkan driver with Termux's Vulkan loader.

pkgname=mesa-vulkan-icd-wrapper
pkgver=25.0.0
pkgrel=1
pkgdesc="Mesa-style Vulkan ICD wrapper for Mali GPUs. Registers Mali's Vulkan driver with Termux's Vulkan loader."
arch=('aarch64')
url="https://github.com/ar37-rs/virgl-angle"
license=('MIT')
depends=('vulkan-loader-generic')
options=('!strip' '!buildflags')

# Try source-based build first; fall back to prebuilt
source=("mesa-vulkan-icd-wrapper::https://github.com/ar37-rs/virgl-angle/releases/download/latest/mesa-vulkan-icd-wrapper_25.0.0-1_aarch64.deb")
sha256sums=('SKIP')

build() {
    # Try to detect Mali Vulkan driver on the device
    # Common locations for Mali Vulkan driver
    MALI_DRIVER=""
    for path in \
        /vendor/lib64/hw/vulkan.mali.so \
        /vendor/lib/hw/vulkan.mali.so \
        /system/vendor/lib64/hw/vulkan.mali.so \
        /system/lib64/hw/vulkan.mali.so; do
        if [ -f "$path" ]; then
            MALI_DRIVER="$path"
            break
        fi
    done

    mkdir -p "$srcdir/usr/share/vulkan/icd.d"

    if [ -n "$MALI_DRIVER" ] && [ -r "$MALI_DRIVER" ]; then
        # Create ICD JSON pointing directly to Mali's driver
        echo "==> Mali Vulkan driver found at: $MALI_DRIVER"
        echo "==> Creating ICD JSON..."
        cat > "$srcdir/usr/share/vulkan/icd.d/mali.json" << EOF
{
    "file_format_version": "1.0.0",
    "ICD": {
        "library_path": "$MALI_DRIVER",
        "api_version": "1.3"
    }
}
EOF
    else
        # Mali driver not detected at build time
        # Fall back to a wrapper approach: create a symlink-based ICD
        echo "==> Mali driver not detected on this device."
        echo "==> Creating generic ICD wrapper (will auto-detect at runtime)..."

        # Create install script that detects at install time
        mkdir -p "$srcdir/DEBIAN"
        cat > "$srcdir/DEBIAN/postinst" << 'POSTINST'
#!/data/data/com.termux/files/usr/bin/bash
# Post-installation script: detect Mali Vulkan driver
ICD_DIR="$PREFIX/share/vulkan/icd.d"
ICD_FILE="$ICD_DIR/mali.json"

for path in \
    /vendor/lib64/hw/vulkan.mali.so \
    /vendor/lib/hw/vulkan.mali.so \
    /system/vendor/lib64/hw/vulkan.mali.so \
    /system/lib64/hw/vulkan.mali.so; do
    if [ -f "$path" ]; then
        mkdir -p "$ICD_DIR"
        cat > "$ICD_FILE" << 'EOF'
{
    "file_format_version": "1.0.0",
    "ICD": {
        "library_path": "__MALI_PATH__",
        "api_version": "1.3"
    }
}
EOF
        sed -i "s|__MALI_PATH__|$path|" "$ICD_FILE"
        echo "Mali ICD configured: $path"
        exit 0
    fi
done

echo "WARNING: Mali Vulkan driver not found!"
echo "The package mesa-vulkan-icd-wrapper may not work on this device."
echo "Try downloading the pre-built .deb from ar37-rs/virgl-angle releases."
POSTINST
        chmod +x "$srcdir/DEBIAN/postinst"
    fi
}

package() {
    # If we have a direct ICD JSON, use it
    if [ -f "$srcdir/usr/share/vulkan/icd.d/mali.json" ]; then
        install -Dm644 "$srcdir/usr/share/vulkan/icd.d/mali.json" \
            "$pkgdir/data/data/com.termux/files/usr/share/vulkan/icd.d/mali.json"
    fi

    # If we have a pre-built .deb fallback, extract from it
    if [ -f "$srcdir/mesa-vulkan-icd-wrapper_25.0.0-1_aarch64.deb" ]; then
        cd "$srcdir"
        ar p mesa-vulkan-icd-wrapper_25.0.0-1_aarch64.deb data.tar.xz | tar -xJ -C "$pkgdir" 2>/dev/null || true
    fi
}
