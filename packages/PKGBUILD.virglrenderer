# PKGBUILD for virglrenderer 1.3.0
# Builds from source using meson. Produces virgl_test_server binary.
#
# Source: https://gitlab.freedesktop.org/virgl/virglrenderer
# Reference: Termux build.sh

pkgname=virglrenderer
pkgver=1.3.0
pkgrel=1
pkgdesc="VirGL virtual OpenGL renderer (virgl_test_server). Build from freedesktop.org source."
arch=('aarch64')
url="https://gitlab.freedesktop.org/virgl/virglrenderer"
license=('MIT')
depends=('libdrm' 'libepoxy' 'libglvnd' 'libx11' 'mesa')
makedepends=('meson' 'ninja' 'pkg-config')
source=("https://gitlab.freedesktop.org/virgl/virglrenderer/-/archive/virglrenderer-${pkgver}/virglrenderer-virglrenderer-${pkgver}.tar.gz")
sha256sums=('56170f8caa1bb642a2624b649e3bcca095ec2834814e5c308efc8a85a709e4ce')

build() {
    cd "$srcdir/virglrenderer-virglrenderer-${pkgver}"

    # -Wno-error needed for gnu-offsetof-extensions
    CFLAGS+=" -Wno-error=gnu-offsetof-extensions"

    meson setup build \
        -Dplatforms=egl,glx \
        -Dvenus=true \
        --prefix /data/data/com.termux/files/usr
}

package() {
    cd "$srcdir/virglrenderer-virglrenderer-${pkgver}"
    DESTDIR="$pkgdir" ninja -C build install
}
