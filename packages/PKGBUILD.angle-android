# PKGBUILD for angle-android
#
# NOTE: Building ANGLE from source requires Google's depot_tools, GN, Ninja,
# the Android NDK, and a Chromium-scale build infrastructure. This is not
# practical to do on-device in Termux.
#
# This PKGBUILD uses a pre-built .deb from ar37-rs/virgl-angle releases,
# which contains the official Google ANGLE libraries compiled for Android.
#
# For those who want to build from source, Google's ANGLE source is at:
#   https://chromium.googlesource.com/angle/angle
# And the build process (for desktop/CI) is documented at:
#   https://chromium.googlesource.com/angle/angle/+/main/doc/DevSetup.md

pkgname=angle-android
pkgver=2.1.2
pkgrel=1
pkgdesc="ANGLE (Almost Native Graphics Layer Engine) for Android. Pre-built binaries repackaged for Termux pacman."
arch=('aarch64')
url="https://github.com/google/angle"
license=('Apache')
depends=('vulkan-loader-generic')
options=('!strip' '!buildflags')
source=("https://github.com/ar37-rs/virgl-angle/releases/download/latest/angle-android_2.1.2-latest.deb")
sha256sums=('SKIP')

package() {
    cd "$srcdir"
    # Extract the .deb into package dir
    ar p angle-android_2.1.2-latest.deb data.tar.xz | tar -xJ -C "$pkgdir"

    # Fix permissions
    find "$pkgdir" -type d -exec chmod 755 {} \;
    find "$pkgdir" -type f -exec chmod 644 {} \;
    find "$pkgdir" -type f -name '*.so' -exec chmod 755 {} \;
}
