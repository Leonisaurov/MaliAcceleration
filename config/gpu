  gpu 4.6COMPAT                OpenGL 4.6 Compatibility Profile
  gpu 3.2CORE                  OpenGL 3.2 Core Profile
  gpu 3.3CORE                  OpenGL 3.3 Core Profile
  gpu 4.1CORE                  OpenGL 4.1 Core Profile
  gpu 4.3CORE                  OpenGL 4.3 Core Profile
  gpu 4.5CORE                  OpenGL 4.5 Core Profile
  gpu 4.6CORE                  OpenGL 4.6 Core Profile

  ── Configuration ──
  gpu config=d3d / cfg=d3d     Enable Direct3D compatibility mode
  gpu config=gl  / cfg=gl      Disable Direct3D mode (default)

  ── Updates ──
  gpu update-angle             Download & install latest ANGLE build (CI)
  gpu update-renderer          Download & install latest virglrenderer (CI)
  gpu update-virgl             Same as update-renderer
  gpu update-icd               Download & install latest ICD wrapper (CI)
  gpu update-all               Update all GPU packages from CI

  ── Run an app ──
  gpu <app> [args...]          Start server (if needed) + run app
                               with GPU acceleration enabled.

  Examples:
    gpu glxgears -info
    gpu glmark2
    gpu firefox
    gpu 4.3COMPAT
    gpu angle=vulkan
    gpu info
    gpu q
HELP
}

# ===========================================================================
#  MAIN — argument dispatch
# ===========================================================================

case "${1:-}" in
    "")
        # No args → start server
        start_vgl_server
        ;;

    --help|-h)
        vhelp
        ;;

    q)
        kill_vgl_server
        ;;

    info)
        show_info
        ;;

    angle=vulkan)
        kill_vgl_server
        rm -f "$HOME/.vgl-angle-gl"
        touch "$HOME/.vgl-angle-vulkan"
        rm -f "$HOME/.vgl-android"
        start_vgl_server
        ;;

    angle=vulkan-null)
        kill_vgl_server
        rm -f "$HOME/.vgl-angle-vulkan" "$HOME/.vgl-angle-gl"
        rm -f "$HOME/.vgl-android"
        start_vgl_server
        ;;

    angle=gl)
        kill_vgl_server
        rm -f "$HOME/.vgl-angle-vulkan"
        touch "$HOME/.vgl-angle-gl"
        rm -f "$HOME/.vgl-android"
        start_vgl_server
        ;;

    use-android)
        kill_vgl_server
        touch "$HOME/.vgl-android"
        start_vgl_server
        ;;

    use-angle)
        kill_vgl_server
        rm -f "$HOME/.vgl-android"
        start_vgl_server
        ;;

    2.1COMPAT|3.2COMPAT|3.3COMPAT|4.1COMPAT|4.3COMPAT|4.5COMPAT|4.6COMPAT| \
    3.2CORE|3.3CORE|4.1CORE|4.3CORE|4.5CORE|4.6CORE)
        set_profile "$1"
        ;;

    config=d3d|cfg=d3d)
        touch "$HOME/.vgl-d3d"
        echo "using d3d (Direct 3D) config."
        ;;

    config=gl|cfg=gl)
        rm -f "$HOME/.vgl-d3d"
        echo "using OpenGL/ES config."
        ;;

    update-angle)
        echo "Updating angle-android from CI build..."
        kill_vgl_server
        if gh_release_download "angle-android*.pkg.tar.xz" "$HOME"; then
            PKG_FILE=$(ls "$HOME"/angle-android*.pkg.tar.xz 2>/dev/null | head -1)
            if [ -n "$PKG_FILE" ]; then
                pacman -U --noconfirm --overwrite='*' "$PKG_FILE"
                rm -f "$PKG_FILE"
                echo "angle-android updated."
            fi
        fi
        sleep 1
        start_vgl_server
        echo "done."
        ;;

    update-renderer|update-virgl)
        echo "Updating virglrenderer from CI build..."
        kill_vgl_server
        if gh_release_download "virglrenderer*.pkg.tar.xz" "$HOME"; then
            PKG_FILE=$(ls "$HOME"/virglrenderer*.pkg.tar.xz 2>/dev/null | head -1)
            if [ -n "$PKG_FILE" ]; then
                pacman -U --noconfirm --overwrite='*' "$PKG_FILE"
                rm -f "$PKG_FILE"
                echo "virglrenderer updated."
            fi
        fi
        sleep 1
        start_vgl_server
        echo "done."
        ;;

    update-icd)
        echo "Updating mesa-vulkan-icd-wrapper from CI build..."
        if gh_release_download "mesa-vulkan-icd-wrapper*.pkg.tar.xz" "$HOME"; then
            PKG_FILE=$(ls "$HOME"/mesa-vulkan-icd-wrapper*.pkg.tar.xz 2>/dev/null | head -1)
            if [ -n "$PKG_FILE" ]; then
                pacman -U --noconfirm --overwrite='*' "$PKG_FILE"
                rm -f "$PKG_FILE"
                echo "ICD wrapper updated."
            fi
        fi
        echo "done."
        ;;

    update-all)
        echo "Updating all GPU packages from CI build..."
        for subcmd in update-renderer update-angle update-icd; do
            echo ""
            echo "--- $subcmd ---"
            "$0" "$subcmd"
        done
        echo ""
        echo "All packages updated."
        ;;

    *)
        # Run an app with GPU acceleration
        if ! server_running; then
            start_vgl_server
        fi
        apply_env

        if [ -f "$HOME/.vgl-zink-xlib-compat" ]; then
            LD_LIBRARY_PATH= exec "$@"
        else
            exec "$@"
        fi
        ;;
esac
